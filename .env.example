# คัดลอกเป็น .env (deploy.sh สร้าง APP_SECRET ให้เองถ้ายังไม่มี) — ห้าม commit .env
APP_SECRET=

# รูปแบบ "ให้ AI จัดหน้าใหม่" — ใช้ virtual key ของ LiteLLM (ไม่ใช่ key ของผู้ให้บริการตรง)
LITELLM_BASE_URL=https://litellm.app.inhdy.com
LITELLM_API_KEY=
LITELLM_MODEL=            # ว่างได้: ใช้โมเดลแรกที่ key นี้มีสิทธิ์ใน LiteLLM

# โมเดลที่ worker ใช้ดึงไฟล์จาก claude.ai (ผ่าน claude CLI ที่ login ไว้บนเครื่องนี้)
CLAUDE_FETCH_MODEL=claude-haiku-5-5

# Artifact tool เปิดเฉพาะบาง entrypoint ของ Claude Code — ค่าเริ่มต้น claude-vscode
CLAUDE_FETCH_ENTRYPOINT=claude-vscode
